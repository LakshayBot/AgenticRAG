{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=rag_system;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "JwtSettings": {
    "SecretKey": "your-super-secret-key-min-32-characters-long-change-in-production",
    "Issuer": "RagSystem",
    "Audience": "RagSystemUsers",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "PythonServices": {
    "PdfService": {
      "BaseUrl": "http://localhost:8001"
    },
    "EmbeddingsService": {
      "BaseUrl": "http://localhost:8002"
    },
    "SearchService": {
      "BaseUrl": "http://localhost:8003"
    },
    "AgenticRAGService": {
      "BaseUrl": "http://localhost:8004"
    },
    "AdvisoryService": {
      "BaseUrl": "http://localhost:8005"
    }
  },
  "Upload": {
    "Directory": "./uploads",
    "MaxSizeMB": 20,
    "AllowedExtensions": [".pdf"]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "OAuth": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "GitHub": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "RedirectBaseUrl": "http://localhost:3000"
  },
  "AllowedHosts": "*"
